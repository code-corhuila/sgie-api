# Copia este archivo a backend/.env y completa los valores reales.
# backend/.env está en .gitignore: nunca subas valores reales al repositorio.

# Perfil de Spring a activar: dev, qa o prod
SPRING_PROFILES_ACTIVE=dev

# Debe coincidir con DB_PASSWORD en db/.env
DB_PASSWORD=

# Genera uno nuevo, no reutilices secretos expuestos previamente
JWT_SECRET=

# Cuenta de correo usada para notificaciones (SMTP)
MAIL_USERNAME=
# Contraseña de aplicación de esa cuenta (no la contraseña normal)
MAIL_PASSWORD=
